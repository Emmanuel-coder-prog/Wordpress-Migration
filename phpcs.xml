<?xml version="1.0"?>
<ruleset name="Cetech Project Ruleset">
  <description>Project-level PHPCS ruleset for Cetech — use WordPress standards where available.</description>

  <!-- Use WordPress Coding Standards if available, fallback to PSR12 via phpcs settings. -->
  <rule ref="WordPress"/>

  <!-- Files and directories to scan by default when phpcs is run without args -->
  <file>docker</file>
  <file>scripts</file>
  <file>apps/corporate/wp-content/mu-plugins</file>
  <file>apps/corporate/wp-content/themes</file>
  <file>apps/blog-en/wp-content/mu-plugins</file>
  <file>apps/blog-en/wp-content/themes</file>
  <file>apps/store-gh/wp-content/mu-plugins</file>
  <file>apps/store-gh/wp-content/themes</file>
  <file>apps/shared/wp-content/mu-plugins</file>

  <!-- Exclude third-party and generated directories -->
  <exclude-pattern>*/vendor/*</exclude-pattern>
  <exclude-pattern>*/node_modules/*</exclude-pattern>
  <exclude-pattern>*/.git/*</exclude-pattern>
  <exclude-pattern>*/cache/*</exclude-pattern>
  <exclude-pattern>*/build/*</exclude-pattern>
  <exclude-pattern>*/dist/*</exclude-pattern>

  <!-- Note: do not set CLI-style args here; keep defaults and limit files above. -->

</ruleset>
